%------------------------------------------------------------------------------
% Skolem axioms for the Skolem functions of GEO004-0 (fixed), GEO004-1, GEO004-2, GEO004-3 (tptp2X clausifications
% of GEO004+0 (fixed) .. GEO004+3). Each has the form  ! [Xs] : ( ? [Y] : phi(Xs,Y) => phi(Xs,sk(Xs)) ), with sk a
% fresh function symbol, so it is conservative: every model of the fof axioms expands to a model of these by
% interpreting sk(Xs) as a witness of phi(Xs,_) where one exists (choice), and arbitrarily otherwise.
% Argument orders follow the clauses in the cnf files.
%------------------------------------------------------------------------------
% GEO004-0
fof(sk_ax0_sk1,axiom, ! [A,B] : ( ? [P] : ( incident_c(P,A) & ~ incident_c(P,B) )
    => ( incident_c(ax0_sk1(A,B),A) & ~ incident_c(ax0_sk1(A,B),B) ) ) ).
fof(sk_ax0_sk2,axiom, ! [A,B,C] : ( ? [Q] : ~ ( incident_c(Q,C) <=> ( incident_c(Q,B) | incident_c(Q,A) ) )
    => ~ ( incident_c(ax0_sk2(A,B,C),C) <=> ( incident_c(ax0_sk2(A,B,C),B) | incident_c(ax0_sk2(A,B,C),A) ) ) ) ).
fof(sk_ax0_sk34,axiom, ! [B,A] : ( ? [C1,C2] : ( part_of(C1,B) & part_of(C2,B) & incident_c(A,C1) & incident_c(A,C2)
      & ~ part_of(C1,C2) & ~ part_of(C2,C1) )
    => ( part_of(ax0_sk3(B,A),B) & part_of(ax0_sk4(B,A),B) & incident_c(A,ax0_sk3(B,A)) & incident_c(A,ax0_sk4(B,A))
      & ~ part_of(ax0_sk3(B,A),ax0_sk4(B,A)) & ~ part_of(ax0_sk4(B,A),ax0_sk3(B,A)) ) ) ).
fof(sk_ax0_sk5,axiom, ! [C,B,A] : ( ? [Q] : ( incident_c(Q,B) & incident_c(Q,C) & ~ ( end_point(Q,B) & end_point(Q,C) ) )
    => ( incident_c(ax0_sk5(C,B,A),B) & incident_c(ax0_sk5(C,B,A),C)
      & ~ ( end_point(ax0_sk5(C,B,A),B) & end_point(ax0_sk5(C,B,A),C) ) ) ) ).
fof(sk_ax0_sk6,axiom, ! [A] : ( ? [P] : end_point(P,A) => end_point(ax0_sk6(A),A) ) ).
fof(sk_ax0_sk7,axiom, ! [A] : ( ? [P] : end_point(P,A) => end_point(ax0_sk7(A),A) ) ).
fof(sk_ax0_sk8,axiom, ! [A] : ( ? [P] : inner_point(P,A) => inner_point(ax0_sk8(A),A) ) ).
fof(sk_ax0_sk910,axiom, ! [A,B] : ( ? [C1,C2] : ( meet(A,C1,C2) & B = sum(C1,C2) )
    => ( meet(A,ax0_sk9(A,B),ax0_sk10(A,B)) & B = sum(ax0_sk9(A,B),ax0_sk10(A,B)) ) ) ).
fof(sk_ax0_sk11,axiom, ! [A,B] : ( ? [Q] : ( end_point(Q,B) & A != Q )
    => ( end_point(ax0_sk11(A,B),B) & A != ax0_sk11(A,B) ) ) ).
fof(sk_ax0_sk12,axiom, ! [C,B] : ( ? [D] : D = sum(B,C) => ax0_sk12(C,B) = sum(B,C) ) ).
fof(sk_ax0_sk13,axiom, ! [A,B] : ( ? [P] : ~ ( incident_c(P,B) <=> incident_c(P,A) )
    => ~ ( incident_c(ax0_sk13(A,B),B) <=> incident_c(ax0_sk13(A,B),A) ) ) ).
% GEO004-1
fof(sk_ax1_sk1,axiom, ! [D,C,B,A] : ( ? [E] : ( part_of(E,A) & end_point(B,E) & end_point(D,E) & inner_point(C,E) )
    => ( part_of(ax1_sk1(D,C,B,A),A) & end_point(B,ax1_sk1(D,C,B,A)) & end_point(D,ax1_sk1(D,C,B,A))
      & inner_point(C,ax1_sk1(D,C,B,A)) ) ) ).
% GEO004-2
fof(sk_ax2_sk1,axiom, ! [B,A] : ( ? [Q] : ( A != Q & incident_o(Q,B) & ~ ordered_by(B,A,Q) )
    => ( A != ax2_sk1(B,A) & incident_o(ax2_sk1(B,A),B) & ~ ordered_by(B,A,ax2_sk1(B,A)) ) ) ).
fof(sk_ax2_sk2,axiom, ! [B,A] : ( ? [Q] : ( A != Q & incident_o(Q,B) & ~ ordered_by(B,Q,A) )
    => ( A != ax2_sk2(B,A) & incident_o(ax2_sk2(B,A),B) & ~ ordered_by(B,ax2_sk2(B,A),A) ) ) ).
fof(sk_ax2_sk3,axiom, ! [A] : ( ? [C] : ( open(C) & ! [P] : ( incident_o(P,A) <=> incident_c(P,C) ) )
    => ( open(ax2_sk3(A)) & ! [P] : ( incident_o(P,A) <=> incident_c(P,ax2_sk3(A)) ) ) ) ).
fof(sk_ax2_sk4,axiom, ! [A,D,C,B] : ( ? [E] : ( ! [P] : ( incident_o(P,A) <=> incident_c(P,E) ) & between_c(E,B,C,D) )
    => ( ! [P] : ( incident_o(P,A) <=> incident_c(P,ax2_sk4(A,D,C,B)) ) & between_c(ax2_sk4(A,D,C,B),B,C,D) ) ) ).
fof(sk_ax2_sk5,axiom, ! [A,B,C,D,E] : ( ? [X] : ~ ( incident_o(X,B) <=> incident_c(X,A) )
    => ~ ( incident_o(ax2_sk5(A,B,C,D,E),B) <=> incident_c(ax2_sk5(A,B,C,D,E),A) ) ) ).
fof(sk_ax2_sk6,axiom, ! [A] : ( ? [P] : start_point(P,A) => start_point(ax2_sk6(A),A) ) ).
fof(sk_ax2_sk7,axiom, ! [A,C,B] : ( ? [O] : ( ! [R] : ( incident_o(R,O) <=> incident_c(R,A) ) & ordered_by(O,B,C) )
    => ( ! [R] : ( incident_o(R,ax2_sk7(A,C,B)) <=> incident_c(R,A) ) & ordered_by(ax2_sk7(A,C,B),B,C) ) ) ).
fof(sk_ax2_sk89,axiom, ! [B,A] : ( ? [P,Q] : ~ ( ordered_by(A,P,Q) <=> ordered_by(B,P,Q) )
    => ~ ( ordered_by(A,ax2_sk8(B,A),ax2_sk9(B,A)) <=> ordered_by(B,ax2_sk8(B,A),ax2_sk9(B,A)) ) ) ).
fof(sk_ax2_sk10,axiom, ! [A,B] : ( ? [P] : ~ ( incident_o(P,A) <=> incident_c(P,B) )
    => ~ ( incident_o(ax2_sk10(A,B),A) <=> incident_c(ax2_sk10(A,B),B) ) ) ).
% GEO004-3
fof(sk_ax3_sk1,axiom, ! [A] : ( ? [O] : trajectory_of(A) = O => trajectory_of(A) = ax3_sk1(A) ) ).
fof(sk_ax3_sk2,axiom, ! [B,A] : ( ? [P] : once(at_the_same_time(A,at(B,P)))
    => once(at_the_same_time(A,at(B,ax3_sk2(B,A)))) ) ).
